<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Die Abläufe: einen Prüflauf zusammenstellen, die Prüfungen der Reihe nach ausführen,
    Fortschritt melden, abbrechen. Kennt den Core, aber keine Oberfläche und keinen
    konkreten Netz-/DNS-Zugriff; die liegen hinter den Core-Abstraktionen.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SiteCheck.Core\SiteCheck.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SiteCheck.Application.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <!-- Verkleinerte Schriften für den HTML-Bericht, erzeugt mit tools/build-report-fonts.ps1.
       Feste logische Namen, damit ein Umbenennen des Ordners den Bericht nicht still bricht. -->
  <ItemGroup>
    <EmbeddedResource Include="Fonts\roboto-flex-latin.woff2" LogicalName="SiteCheck.Fonts.roboto-flex-latin.woff2" />
    <EmbeddedResource Include="Fonts\roboto-mono-latin.woff2" LogicalName="SiteCheck.Fonts.roboto-mono-latin.woff2" />
  </ItemGroup>

</Project>
