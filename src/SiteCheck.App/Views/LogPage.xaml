<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SiteCheck.App.Views.LogPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:SiteCheck.App.Converters"
    xmlns:models="using:SiteCheck.Core.Models"
    Background="{ThemeResource AppBackgroundBrush}">
    <Page.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <DataTemplate x:Key="LogEntryTemplate" x:DataType="models:LogEntry">
            <Border
                Background="{ThemeResource SurfaceBrush}"
                BorderBrush="{ThemeResource HairlineBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource SurfaceCornerRadius}"
                Margin="0,0,0,6"
                Padding="12,8">
                <StackPanel Spacing="2">
                    <TextBlock Foreground="{ThemeResource TextSecondaryBrush}" FontSize="11">
                        <Run Text="{x:Bind Timestamp}" />
                        <Run Text="·" />
                        <Run Text="{x:Bind Level}" FontWeight="SemiBold" />
                    </TextBlock>
                    <TextBlock
                        Text="{x:Bind Text}"
                        Foreground="{ThemeResource TextPrimaryBrush}"
                        TextWrapping="Wrap"
                        IsTextSelectionEnabled="True" />
                </StackPanel>
            </Border>
        </DataTemplate>
    </Page.Resources>
    <Grid Padding="{StaticResource PagePadding}" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Spacing="2">
                <TextBlock x:Uid="LogPage_Title" Style="{StaticResource PageTitleTextStyle}" />
                <TextBlock x:Uid="LogPage_Subtitle" Style="{StaticResource PageSubtitleTextStyle}" />
            </StackPanel>
            <Button
                Grid.Column="1"
                x:Uid="LogPage_ReloadButton"
                Style="{StaticResource PrimaryActionButtonStyle}"
                VerticalAlignment="Center"
                Command="{x:Bind ViewModel.ReloadCommand}" />
        </Grid>
        <Grid Grid.Row="1" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox
                Grid.Column="0"
                x:Uid="LogPage_Search"
                Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <ToggleButton
                Grid.Column="1"
                x:Uid="LogPage_FilterAll"
                IsChecked="{x:Bind ViewModel.ShowsAll, Mode=OneWay}"
                Click="OnFilterAll" />
            <ToggleButton
                Grid.Column="2"
                x:Uid="LogPage_FilterWarnings"
                IsChecked="{x:Bind ViewModel.ShowsWarnings, Mode=OneWay}"
                Click="OnFilterWarnings" />
            <ToggleButton
                Grid.Column="3"
                x:Uid="LogPage_FilterErrors"
                IsChecked="{x:Bind ViewModel.ShowsErrors, Mode=OneWay}"
                Click="OnFilterErrors" />
        </Grid>
        <Grid Grid.Row="2">
            <TextBlock
                Text="{x:Bind ViewModel.EmptyText, Mode=OneWay}"
                Style="{StaticResource MutedTextStyle}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{x:Bind ViewModel.Entries}" ItemTemplate="{StaticResource LogEntryTemplate}" />
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
