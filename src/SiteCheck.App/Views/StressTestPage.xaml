<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SiteCheck.App.Views.StressTestPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:SiteCheck.App.Converters"
    Background="{ThemeResource AppBackgroundBrush}">

    <Page.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />
    </Page.Resources>

    <Grid Padding="{StaticResource PagePadding}" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="2">
            <TextBlock Text="Stresstest" Style="{StaticResource PageTitleTextStyle}" />
            <TextBlock
                Text="Belastet die Seite kurz mit vielen gleichzeitigen Anfragen und misst die Antwortzeiten."
                Style="{StaticResource PageSubtitleTextStyle}" />
        </StackPanel>

        <StackPanel Grid.Row="1" Spacing="12">
            <InfoBar
                IsOpen="True"
                IsClosable="False"
                Severity="Warning"
                Title="Nur für eigene, selbst gehostete Seiten"
                Message="Dies ist eine aktive Belastung. Vor jedem Lauf wird nachgefragt, ob die Seite dir gehört. Einen fremden oder gemieteten Server so zu belasten, kann als Angriff gelten." />

            <TextBox
                Header="Adresse"
                PlaceholderText="z. B. meine-seite.de"
                Text="{x:Bind ViewModel.AddressInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

            <Grid ColumnSpacing="24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock>
                        <Run Text="Gleichzeitige Anfragen: " />
                        <Run Text="{x:Bind ViewModel.Concurrency, Mode=OneWay}" FontWeight="SemiBold" />
                    </TextBlock>
                    <Slider
                        Minimum="{x:Bind ViewModel.MinConcurrency}"
                        Maximum="{x:Bind ViewModel.MaxConcurrency}"
                        Value="{x:Bind ViewModel.Concurrency, Mode=TwoWay}"
                        StepFrequency="1" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock>
                        <Run Text="Dauer (Sekunden): " />
                        <Run Text="{x:Bind ViewModel.DurationSeconds, Mode=OneWay}" FontWeight="SemiBold" />
                    </TextBlock>
                    <Slider
                        Minimum="{x:Bind ViewModel.MinDuration}"
                        Maximum="{x:Bind ViewModel.MaxDuration}"
                        Value="{x:Bind ViewModel.DurationSeconds, Mode=TwoWay}"
                        StepFrequency="5" />
                </StackPanel>
            </Grid>

            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button
                    Content="Lasttest starten"
                    Style="{StaticResource PrimaryActionButtonStyle}"
                    Command="{x:Bind ViewModel.StartCommand}"
                    Visibility="{x:Bind ViewModel.IsRunning, Mode=OneWay, Converter={StaticResource InverseBoolToVisibility}}" />
                <Button
                    Content="Abbrechen"
                    MinHeight="40"
                    Command="{x:Bind ViewModel.CancelCommand}"
                    Visibility="{x:Bind ViewModel.IsRunning, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>

            <InfoBar
                IsOpen="{x:Bind ViewModel.HasValidationMessage, Mode=OneWay}"
                Severity="Warning"
                IsClosable="False"
                Message="{x:Bind ViewModel.ValidationMessage, Mode=OneWay}" />

            <ProgressBar
                Maximum="1"
                Value="{x:Bind ViewModel.Progress, Mode=OneWay}"
                Visibility="{x:Bind ViewModel.IsRunning, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />

            <TextBlock
                Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                Style="{StaticResource MutedTextStyle}" />
        </StackPanel>

        <Border
            Grid.Row="2"
            VerticalAlignment="Top"
            Style="{StaticResource CardBorderStyle}"
            Visibility="{x:Bind ViewModel.HasResult, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
            <StackPanel Spacing="4">
                <TextBlock Text="ERGEBNIS" Style="{StaticResource SectionHeaderTextStyle}" />
                <TextBlock
                    Text="{x:Bind ViewModel.ResultText, Mode=OneWay}"
                    Style="{StaticResource BodyTextStyle}"
                    IsTextSelectionEnabled="True" />
            </StackPanel>
        </Border>
    </Grid>
</Page>
