  <data name="Dialog_ScopeNotice_Text" xml:space="preserve">
    <value>SiteCheck checks sites from the outside: ordinary requests and DNS lookups, slowly, stopping at the first rejection. Only use it for sites you own or have explicit permission to check. Many providers still treat checks as an attack and temporarily block your address.</value>
  </data>
  <data name="Dialog_ScopeNotice_Title" xml:space="preserve">
    <value>Your own sites only, from the outside only</value>
  </data>
  <data name="Dialog_SensitivePaths_Primary" xml:space="preserve">
