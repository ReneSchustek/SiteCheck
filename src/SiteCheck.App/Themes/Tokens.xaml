<!--
    Theme-unabhängige Bausteine der Gestaltungslinie: Abstände, Radien, Schriftgrößen,
    Randstärken. Enthält bewusst keinen Farbwert; Farben stehen in Palette.xaml.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Abstände: eine Skala, Grundwert 8, alles andere ein Vielfaches davon. -->
    <x:Double x:Key="SpacingXs">4</x:Double>
    <x:Double x:Key="SpacingS">8</x:Double>
    <x:Double x:Key="SpacingM">16</x:Double>
    <x:Double x:Key="SpacingL">24</x:Double>
    <x:Double x:Key="SpacingXl">32</x:Double>

    <Thickness x:Key="PagePadding">24</Thickness>
    <Thickness x:Key="CardPadding">16</Thickness>

    <!-- Ecken: 8 px an Bedienelementen, 12 px an Flächen (gelockerte Linie, 10.10.2026). -->
    <CornerRadius x:Key="ControlCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="OverlayCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="SurfaceCornerRadius">12</CornerRadius>

    <!-- Schriftgrößen. Die Familie steht in der Palette, weil sie zur Marke gehört. -->
    <x:Double x:Key="FontSizeCaption">12</x:Double>
    <x:Double x:Key="FontSizeBody">14</x:Double>
    <x:Double x:Key="FontSizeSubtitle">16</x:Double>
    <x:Double x:Key="FontSizeTitle">20</x:Double>
    <x:Double x:Key="FontSizeHeader">28</x:Double>

    <x:Double x:Key="LineHeightBody">23</x:Double>

    <!-- Abschnittsüberschriften klein, gesperrt, in Großbuchstaben: 0.08em = 80 Tausendstel. -->
    <x:Int32 x:Key="SectionHeaderCharacterSpacing">80</x:Int32>

    <Thickness x:Key="HairlineBorderThickness">1</Thickness>
    <x:Double x:Key="TouchTargetMinSize">40</x:Double>

</ResourceDictionary>
