<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="SiteCheck.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    Title="SiteCheck">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <NavigationView
        x:Name="NavView"
        FontFamily="{ThemeResource ThemeFontFamily}"
        PaneDisplayMode="Left"
        IsSettingsVisible="False"
        IsBackButtonVisible="Collapsed"
        SelectionChanged="OnSelectionChanged"
        Loaded="OnLoaded">

        <NavigationView.MenuItems>
            <NavigationViewItem Content="Prüfen" Tag="Check" IsSelected="True">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE721;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="Meine Seiten" Tag="Sites">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE71D;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="Stresstest" Tag="Stress">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xEC4A;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.MenuItems>

        <NavigationView.FooterMenuItems>
            <NavigationViewItem Content="Über" Tag="About">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE946;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.FooterMenuItems>

        <Frame x:Name="ContentFrame" />

    </NavigationView>

</Window>
